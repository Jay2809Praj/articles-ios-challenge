                            </connections>
                        </textField>
                        <button opaque="NO" contentMode="scaleToFill" horizontalHuggingPriority="252" horizontalCompressionResistancePriority="752" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="alh-cb-001" userLabel="Cancel Button">
                            <rect key="frame" x="309" y="3" width="60" height="34"/>
                            <state key="normal" title="Cancel"/>
                            <connections>
